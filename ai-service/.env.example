# ==============================================================================
# ResolvIN AI Service (FastAPI) — Production & Development Environment Reference
# ==============================================================================

# Provider choice: "nvidia" (cloud NIM API) or "mock" (deterministic zero-cost local mock)
AI_PROVIDER=mock

# Cloud NVIDIA NIM API Configuration (required only when AI_PROVIDER=nvidia)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Model Configurations
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
RERANKER_MODEL=nvidia/rerank-qa-mistral-4b
EMBEDDING_DIMENSIONS=2048

# Versions
PROMPT_VERSION=1.0.0
TAXONOMY_VERSION=1.0.0
