# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=samadhan_setu
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here

# NestJS Backend Configuration
BACKEND_PORT=3001
PORT=3001
NODE_ENV=development

# FastAPI AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
RERANKER_MODEL=nvidia/rerank-qa-mistral-4b
EMBEDDING_DIMENSIONS=2048

# Application Name (Configurable Display Name)
APP_NAME=SamadhanPlatform

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SARVAM_API_KEY=your_sarvam_api_key_here

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
FRONTEND_PORT=3000
