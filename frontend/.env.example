# ==============================================================================
# ResolvIN Frontend (Next.js) — Production & Development Environment Reference
# ==============================================================================

# Public API URL accessed by client-side browser fetches
NEXT_PUBLIC_API_URL=https://your-backend-api-domain.com/api

# Internal Backend URL accessed by Next.js server rewrites
BACKEND_URL=https://your-backend-api-domain.com/api

# AI Service URL (Optional client-side fallback/status)
NEXT_PUBLIC_AI_SERVICE_URL=https://your-ai-service-domain.com
