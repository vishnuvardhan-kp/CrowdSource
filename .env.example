# ==============================================================================
# ResolvIN Platform — Production & Development Environment Reference
# NOTE: Never commit production credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In hosted environments (Neon, Supabase, Render, Railway, AWS RDS), provide DATABASE_URL.
# If DATABASE_URL is set, it takes precedence over discrete DB host/port/user fields.
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_SSL=false

# Discrete database parameters (used if DATABASE_URL is not set):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=samadhan_setu
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password

# ------------------------------------------------------------------------------
# 2. NestJS Backend API Configuration
# ------------------------------------------------------------------------------
PORT=3001
BACKEND_PORT=3001
NODE_ENV=production
APP_NAME=ResolvIN

# CORS Allowed Origins:
# In production, set to your frontend domain (or comma-separated domains).
# Example: https://resolvin.vercel.app,https://mycustomdomain.org
CORS_ORIGIN=http://localhost:3000

# JWT Authentication
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Storage & File Uploads
# In production with ephemeral containers (Render/Railway), mount a persistent volume at this path
UPLOADS_DIR=./uploads/evidence
MAX_EVIDENCE_FILE_SIZE_BYTES=15728640

# AI Microservice Backend Proxy URL
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. FastAPI AI Service Configuration
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
# AI Provider: "nvidia" (cloud NIM API inference) or "mock" (deterministic zero-cost fallback)
AI_PROVIDER=mock
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
RERANKER_MODEL=nvidia/rerank-qa-mistral-4b
EMBEDDING_DIMENSIONS=2048
PROMPT_VERSION=1.0.0
TAXONOMY_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 4. Next.js Web Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Public API URL used by browser client to communicate with backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Internal backend URL used by Next.js server-side rewrites (if deployed behind proxy)
BACKEND_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
