# ==============================================================================
# ResolvIN Backend (NestJS) — Production & Development Environment Reference
# ==============================================================================

PORT=3001
NODE_ENV=production
APP_NAME=ResolvIN

# Database Configuration (Provide DATABASE_URL or discrete fields)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=samadhan_setu
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password

# CORS Origins (Comma-separated allowed frontend domains)
CORS_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Microservices
AI_SERVICE_URL=http://localhost:8000
RESEARCH_ENGINE_URL=http://localhost:8001

# Storage & Uploads
UPLOADS_DIR=./uploads/evidence
MAX_EVIDENCE_FILE_SIZE_BYTES=15728640
